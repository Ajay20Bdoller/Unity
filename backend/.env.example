# Copy this file to .env and fill in real values. Never commit .env.
# Neon: use the DIRECT (non "-pooler") connection string here for
# running Alembic migrations; the pooled "-pooler" string is fine/better
# for the running app itself.
DATABASE_URL=postgresql://user:password@host/dbname
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
GROK_API_KEY=
# Confirmed provider: Groq (groq.com) — OpenAI-compatible, key prefix
# gsk_. If you ever switch to xAI's actual Grok instead, use:
#   GROK_MODEL=grok-beta
#   GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=llama-3.3-70b-versatile
# "Sign in with Google" -- leave blank to disable it entirely (the
# button just won't render; nothing else breaks). Only a Client ID is
# needed, never a client secret -- this uses Google Identity Services'
# ID-token flow, verified server-side against Google's public keys.
# Get one: console.cloud.google.com/apis/credentials -> Create
# Credentials -> OAuth client ID -> Web application -> add your
# frontend's exact origin (e.g. https://yourapp.vercel.app, and
# http://localhost:3000 for local dev) under "Authorized JavaScript
# origins". No redirect URI needed for this flow.
GOOGLE_CLIENT_ID=
GROK_BASE_URL=https://api.groq.com/openai/v1
AI_MAX_TOKENS=500
AI_TEMPERATURE=0.4
AI_REQUEST_TIMEOUT=20
AI_MAX_MESSAGE_LENGTH=2000
AI_RATE_LIMIT_PER_MINUTE=10
# Comma-separate multiple origins. Must be the EXACT origin the browser
# sends (scheme + host + port, no trailing slash) -- e.g.
# https://yourapp.vercel.app, not https://yourapp.vercel.app/
CORS_ORIGINS=http://localhost:3000
# development: SameSite=Lax cookies, no Secure flag (works over plain
#   http://localhost), OTPs echoed in API responses (no SMS wired up).
# anything else (e.g. production): SameSite=None + Secure cookies
#   (required for the frontend and backend to be on different domains,
#   e.g. vercel.app and railway.app -- see app/api/routes/auth.py's
#   _set_auth_cookies), and OTPs are hidden UNLESS EXPOSE_DEV_OTP=true
#   below.
ENVIRONMENT=development
# Independent of ENVIRONMENT: whether OTPs (password reset, guardian
# consent) are echoed in API responses instead of only being "sent"
# (there's no real SMS provider yet). Leave unset to default to
# matching ENVIRONMENT. Set explicitly to true for a pilot deployment
# that needs ENVIRONMENT=production (for secure cookies) but still
# needs to see OTPs somewhere until a real SMS provider is added --
# turn this back off the moment one exists, since leaving it on in a
# real production deployment means anyone can read an OTP straight out
# of the API response.
# EXPOSE_DEV_OTP=true
