# Copy this file to .env and fill in real values. Never commit .env.
# Neon: use the DIRECT (non "-pooler") connection string here for
# running Alembic migrations; the pooled "-pooler" string is fine/better
# for the running app itself.
DATABASE_URL=postgresql://user:password@host/dbname
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
GROK_API_KEY=
# Default below is xAI's Grok. If your key instead starts with "gsk_",
# that's a Groq (groq.com) key, not xAI's Grok — easy mix-up. Groq is
# also OpenAI-compatible: swap these two lines for
#   GROK_BASE_URL=https://api.groq.com/openai/v1
#   GROK_MODEL=llama-3.3-70b-versatile   (or another current Groq model)
GROK_MODEL=grok-beta
GROK_BASE_URL=https://api.x.ai/v1
AI_MAX_TOKENS=500
AI_TEMPERATURE=0.4
AI_REQUEST_TIMEOUT=20
AI_MAX_MESSAGE_LENGTH=2000
AI_RATE_LIMIT_PER_MINUTE=10
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
